{
  "name": "@bx-team/monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:meridian": "bun run --filter @bx-team/meridian dev",
    "dev:beacon": "bun run --filter @bx-team/beacon dev",
    "dev:azimuth": "bun run --filter @bx-team/azimuth dev",
    "build": "bun run --filter '*' build",
    "build:meridian": "bun run --filter @bx-team/meridian generate",
    "build:beacon": "bun run --filter @bx-team/beacon build",
    "build:azimuth": "bun run --filter @bx-team/azimuth build",
    "deploy:meridian": "bun run --filter @bx-team/meridian deploy",
    "deploy:beacon": "bun run --filter @bx-team/beacon deploy",
    "deploy:azimuth": "bun run --filter @bx-team/azimuth deploy",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.13"
}
