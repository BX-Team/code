{
  "name": "@bx-team/monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter @bx-team/web dev",
    "dev:beacon": "bun run --filter @bx-team/beacon dev",
    "dev:api": "bun run --filter @bx-team/api dev",
    "dev:helm": "bun run --filter @bx-team/helm dev",
    "build": "bun run --filter '*' build",
    "build:web": "bun run --filter @bx-team/web generate",
    "build:beacon": "bun run --filter @bx-team/beacon build",
    "build:api": "bun run --filter @bx-team/api build",
    "build:helm": "bun run --filter @bx-team/helm build",
    "deploy:web": "bun run --filter @bx-team/web deploy",
    "deploy:beacon": "bun run --filter @bx-team/beacon deploy",
    "deploy:api": "bun run --filter @bx-team/api deploy",
    "deploy:helm": "bun run --filter @bx-team/helm deploy",
    "upload:web": "bun run --filter @bx-team/web upload",
    "upload:beacon": "bun run --filter @bx-team/beacon upload",
    "upload:api": "bun run --filter @bx-team/api upload",
    "upload:helm": "bun run --filter @bx-team/helm upload",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.3"
}
