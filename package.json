{
  "name": "@bx-team/monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:meridian": "bun run --filter @bx-team/meridian dev",
    "dev:influx": "bun run --filter @bx-team/influx dev",
    "dev:cinder": "bun run --filter @bx-team/cinder dev",
    "build": "bun run --filter '*' build",
    "build:meridian": "bun run --filter @bx-team/meridian build",
    "build:influx": "bun run --filter @bx-team/influx build",
    "build:cinder": "bun run --filter @bx-team/cinder build",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.13"
}
