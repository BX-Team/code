{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "baseBranchPatterns": ["master"],
  "commitMessagePrefix": "chore(deps): ",
  "labels": ["🔄 dependencies"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "ignoreTests": true
    },
    {
      "groupName": "Vue / Nuxt ecosystem",
      "matchPackageNames": [
        "vue",
        "nuxt",
        "@nuxt/content",
        "@nuxt/fonts",
        "vue-router",
        "@vueuse/core",
        "@lucide/vue",
        "@shikijs/transformers"
      ]
    },
    {
      "groupName": "Vite & plugins",
      "matchPackageNames": ["vite", "@vitejs/plugin-vue", "@cloudflare/vite-plugin", "@tailwindcss/vite"]
    },
    {
      "groupName": "Tailwind CSS",
      "matchPackageNames": ["tailwindcss", "tw-animate-css"]
    },
    {
      "groupName": "Drizzle ORM",
      "matchPackageNames": ["drizzle-orm", "drizzle-kit"]
    },
    {
      "groupName": "TypeScript & @types",
      "matchPackageNames": ["typescript", "/^@types//"]
    },
    {
      "groupName": "Cloudflare tooling",
      "matchPackageNames": ["wrangler", "/^@cloudflare//"]
    },
    {
      "groupName": "Scalar",
      "matchPackageNames": ["/^@scalar//"]
    }
  ]
}
