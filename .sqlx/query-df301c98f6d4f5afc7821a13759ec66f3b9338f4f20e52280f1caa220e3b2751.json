  "db_name": "PostgreSQL",
  "query": "SELECT id, name, email, email_verified, image, role, banned, ban_reason, ban_expires,\n                created_at, updated_at\n           FROM auth.users\n          WHERE ($1::text IS NULL OR email ILIKE '%' || $1 || '%')\n            AND ($2::bool IS NULL OR banned = $2)\n          ORDER BY created_at DESC\n          LIMIT $3 OFFSET $4",
