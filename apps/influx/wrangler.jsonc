{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "influx",
  "main": "./src/index.ts",
  "compatibility_date": "2026-03-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "ingest.bxteam.org", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "PULSIFY_DB",
      "database_name": "pulsify-db",
      "database_id": "25fe9461-a10d-4a07-bfce-c34b32c99336",
      "migrations_dir": "../../packages/stratus/drizzle/d1/pulsify"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "pulsify-ingest",
        "binding": "INGEST_QUEUE"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 100, "period": 60 }
    }
  ]
}
