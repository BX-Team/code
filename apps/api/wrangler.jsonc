{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-03-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "api.bxteam.org", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "vars": {
    "R2_PUBLIC_URL": "https://files.bxteam.org",
    "BOT_WEBHOOK_URL": "https://bot.bxteam.org/api/webhook"
  },
  "secrets": {
    "required": ["BOT_WEBHOOK_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atlas-db",
      "database_id": "f10f7ede-1373-403a-8149-62b6772532ba",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "builds"
    }
  ]
}
