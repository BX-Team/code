{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zenith",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-03-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "placement": {
    "region": "gcp:europe-west4"
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zenith",
      "database_id": "93d2237a-156c-419f-b710-115afaa7c2d1"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER_HEARTBEAT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 10 }
    },
    {
      "name": "RATE_LIMITER_API",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RATE_LIMITER_ADMIN",
      "namespace_id": "1003",
      "simple": { "limit": 300, "period": 60 }
    }
  ]
}
