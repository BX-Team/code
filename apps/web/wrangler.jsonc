{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  "main": "./worker.ts",
  "compatibility_date": "2026-03-12",
  "workers_dev": false,
  "routes": [{ "pattern": "bxteam.org", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    // English pages go through worker.ts first, which sends a visitor to their language; everything else is served directly.
    "run_worker_first": [
      "/*",
      "!/_nuxt/*",
      "!/_i18n/*",
      "!/__nuxt_content/*",
      "!/fonts/*",
      "!/demo/*",
      "!/projects/*",
      "!/ru/*",
      "!/docs/*"
    ]
  }
}
