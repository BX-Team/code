{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helm",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-03-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "helm.bxteam.org", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_APP_ID": ""
  },
  "secrets": {
    "required": ["GITHUB_APP_PRIVATE_KEY", "GITHUB_WEBHOOK_SECRET"]
  }
}
